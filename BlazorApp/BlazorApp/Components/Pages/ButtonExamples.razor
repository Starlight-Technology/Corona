@page "/components/button"
@using Corona.Components.Enums

<PageTitle>Button | Corona Docs</PageTitle>

<CoronaContainer MaxWidth="CoronaContainerMaxWidth.Xl">
    <CoronaStack Spacing="1.5rem" FullWidth="true">
        <section>
            <h1>Button</h1>
            <p class="docs-page-description">Buttons trigger actions across forms, dialogs, and command surfaces.</p>
        </section>

        <section>
            <h2>Live examples</h2>
            <CoronaStack Spacing="1rem" FullWidth="true">
                <ExampleSection Title="Basic usage"
                                Description="Use the filled variant for primary actions."
                                Code='@("<CoronaButton Variant=\"CoronaButtonVariant.Filled\">Create</CoronaButton>")'>
                    <CoronaButton Variant="CoronaButtonVariant.Filled">Create</CoronaButton>
                </ExampleSection>

                <ExampleSection Title="Variants"
                                Description="Button variants support different visual emphasis levels."
                                Code='@("<CoronaStack Direction=\"CoronaStackDirection.Row\" Spacing=\"0.75rem\">\n    <CoronaButton Variant=\"CoronaButtonVariant.Filled\">Filled</CoronaButton>\n    <CoronaButton Variant=\"CoronaButtonVariant.Outlined\">Outlined</CoronaButton>\n    <CoronaButton Variant=\"CoronaButtonVariant.Text\">Text</CoronaButton>\n</CoronaStack>")'>
                    <CoronaStack Direction="CoronaStackDirection.Row" Spacing="0.75rem" Wrap="CoronaStackWrap.Wrap">
                        <CoronaButton Variant="CoronaButtonVariant.Filled">Filled</CoronaButton>
                        <CoronaButton Variant="CoronaButtonVariant.Outlined">Outlined</CoronaButton>
                        <CoronaButton Variant="CoronaButtonVariant.Text">Text</CoronaButton>
                    </CoronaStack>
                </ExampleSection>

                <ExampleSection Title="Sizes"
                                Description="Use compact sizes in dense layouts and large sizes for key actions."
                                Code='@("<CoronaStack Direction=\"CoronaStackDirection.Row\" Spacing=\"0.75rem\">\n    <CoronaButton Size=\"CoronaComponentSize.Small\">Small</CoronaButton>\n    <CoronaButton Size=\"CoronaComponentSize.Medium\">Medium</CoronaButton>\n    <CoronaButton Size=\"CoronaComponentSize.Large\">Large</CoronaButton>\n</CoronaStack>")'>
                    <CoronaStack Direction="CoronaStackDirection.Row" Spacing="0.75rem" Wrap="CoronaStackWrap.Wrap">
                        <CoronaButton Size="CoronaComponentSize.Small">Small</CoronaButton>
                        <CoronaButton Size="CoronaComponentSize.Medium">Medium</CoronaButton>
                        <CoronaButton Size="CoronaComponentSize.Large">Large</CoronaButton>
                    </CoronaStack>
                </ExampleSection>

                <ExampleSection Title="States"
                                Description="Loading and disabled states communicate async or unavailable actions."
                                Code='@("<CoronaButton Loading=\"isSaving\" Disabled=\"isSaving\" OnClick=\"SaveAsync\">\n    @(isSaving ? \"Saving...\" : \"Save\")\n</CoronaButton>")'>
                    <CoronaButton Loading="_loading" Disabled="_loading" OnClick="ToggleLoading">
                        @(_loading ? "Saving..." : "Save")
                    </CoronaButton>
                </ExampleSection>
            </CoronaStack>
        </section>

        <section>
            <h2>Usage</h2>
            <CodeSnippet Code='@("<CoronaButton Variant=\"CoronaButtonVariant.Filled\"\n              Color=\"CoronaColorSemantic.Primary\"\n              OnClick=\"HandleCreate\">\n    Create project\n</CoronaButton>")' />
        </section>

        <section>
            <h2>Parameters</h2>
            <ParameterTable Parameters="_parameters" />
        </section>

        <section>
            <h2>Best practices</h2>
            <ul>
                <li>Use <code>Filled</code> for the primary action and lower-emphasis variants for secondary actions.</li>
                <li>Prefer concise, verb-first labels such as <em>Save</em>, <em>Delete</em>, or <em>Publish</em>.</li>
                <li>Always set <code>Loading</code> during async operations to prevent accidental double submissions.</li>
            </ul>
        </section>
    </CoronaStack>
</CoronaContainer>

@code {
    private bool _loading;

    private readonly IReadOnlyList<ParameterTable.ParameterDefinition> _parameters =
    [
        new("Variant", "CoronaButtonVariant", "Filled", "Selects visual style: Filled, Outlined, or Text."),
        new("Size", "CoronaComponentSize", "Medium", "Controls button height, padding, and font size."),
        new("Color", "CoronaColorSemantic", "Primary", "Applies semantic color palette tokens."),
        new("Loading", "bool", "false", "Shows a spinner and blocks click interaction."),
        new("Disabled", "bool", "false", "Disables click and applies disabled styling."),
        new("OnClick", "EventCallback", "—", "Callback invoked when the button is pressed.")
    ];

    private async Task ToggleLoading()
    {
        _loading = true;
        await Task.Delay(1200);
        _loading = false;
    }
}

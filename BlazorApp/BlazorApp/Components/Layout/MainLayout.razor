@inherits LayoutComponentBase
@implements IDisposable
@inject CoronaThemeProvider ThemeProvider
@rendermode InteractiveServer

<CoronaPageHeader Title="Corona UI Documentation"
                  ShowMenuButton="true"
                  OnMenuClick="ToggleDrawer"
                  Actions="@HeaderActions" />

<div class="docs-shell">
    <CoronaDrawer Open="_drawerOpen"
                  OpenChanged="OnDrawerChanged"
                  Overlay="true"
                  Width="300px"
                  Class="@DrawerClass">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p class="docs-drawer-title">Documentation</p>
            <CoronaNavMenu Items="DocsNavigation.Items" />
        </CoronaStack>
    </CoronaDrawer>

    <main class="docs-content">
        @Body
    </main>
</div>

@code {
    private bool _drawerOpen;

    private string DrawerClass => "docs-drawer";

    private RenderFragment HeaderActions => @<CoronaStack Direction="Corona.Components.Enums.CoronaStackDirection.Row" Spacing=".5rem">
        <CoronaButton Size="Corona.Components.Enums.CoronaComponentSize.Small"
                      Variant="Corona.Components.Enums.CoronaButtonVariant.Outlined"
                      OnClick="ToggleTheme">
            Toggle @ThemeProvider.CurrentTheme.Mode
        </CoronaButton>
    </CoronaStack>;

    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private Task OnDrawerChanged(bool open)
    {
        _drawerOpen = open;
        return Task.CompletedTask;
    }

    private Task ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        return Task.CompletedTask;
    }

    private Task ToggleTheme()
    {
        ThemeProvider.ToggleTheme();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeProvider.OnChange -= HandleThemeChanged;
    }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject CoronaThemeProvider ThemeProvider
@rendermode InteractiveServer

<CoronaLayoutShell DrawerTitle="Documentation"
                   DrawerWidthPx="300"
                   DrawerOverlay="true"
                   ShowMenuButton="true"
                   DrawerItens="@DocsNavigation.Items"
                   HeaderActions="@HeaderActions">
@Body
</CoronaLayoutShell>

@code {
    private bool _drawerOpen;

    private string DrawerClass => "docs-drawer";

    private RenderFragment HeaderActions =>
    @<CoronaStack Direction="Corona.Components.Enums.CoronaStackDirection.Row" Spacing=".5rem">
        <CoronaButton Size="Corona.Components.Enums.CoronaComponentSize.Small"
                      Variant="Corona.Components.Enums.CoronaButtonVariant.Outlined"
                          OnClick="@EventCallback.Factory.Create(this, ToggleTheme)">
            Toggle @ThemeProvider.CurrentTheme.Mode
        </CoronaButton>
    </CoronaStack>;

    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private Task ToggleTheme()
    {
        ThemeProvider.ToggleTheme();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeProvider.OnChange -= HandleThemeChanged;
    }
}

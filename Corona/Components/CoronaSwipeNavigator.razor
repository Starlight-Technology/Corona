@using Corona.Components.Models
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav

<div class="swipe-container"
     @onpointerdown="StartTouch"
     @onpointerup="EndTouch"
     @onpointercancel="CancelTouch"
     @key="Nav.Uri">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IReadOnlyList<CoronaNavItem> Items { get; set; } = [];
    [Parameter] public double SwipeThresholdPx { get; set; } = 80;

    private double _startX;
    private double _startY;
    private bool _touching;

    private List<string> PageOrder => FlattenItems(Items)
        .Select(item => NormalizeUrl(item.Url))
        .Where(url => url is not null)
        .Select(url => url!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    private void StartTouch(PointerEventArgs e)
    {
        _touching = true;
        _startX = e.ClientX;
        _startY = e.ClientY;
    }

    private void EndTouch(PointerEventArgs e)
    {
        if (!_touching)
        {
            return;
        }

        var deltaX = e.ClientX - _startX;
        var deltaY = e.ClientY - _startY;

        if (Math.Abs(deltaX) >= SwipeThresholdPx && Math.Abs(deltaX) > Math.Abs(deltaY))
        {
            if (deltaX < 0)
            {
                GoNext();
            }
            else
            {
                GoPrev();
            }
        }

        _touching = false;
    }

    private void CancelTouch()
    {
        _touching = false;
    }

    private void GoNext()
    {
        var current = NormalizeCurrentUrl();
        var pageOrder = PageOrder;
        var index = pageOrder.IndexOf(current);

        if (index >= 0 && index < pageOrder.Count - 1)
        {
            Nav.NavigateTo(pageOrder[index + 1]);
        }
    }

    private void GoPrev()
    {
        var current = NormalizeCurrentUrl();
        var pageOrder = PageOrder;
        var index = pageOrder.IndexOf(current);

        if (index > 0)
        {
            Nav.NavigateTo(pageOrder[index - 1]);
        }
    }

    private string NormalizeCurrentUrl()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        return NormalizeRelativeUrl(relativePath);
    }

    private string NormalizeRelativeUrl(string url)
    {
        var absoluteUri = Nav.ToAbsoluteUri(url);
        return NormalizePath(absoluteUri.AbsolutePath);
    }

    private string? NormalizeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return null;
        }

        var absoluteUri = Nav.ToAbsoluteUri(url);
        return NormalizePath(absoluteUri.AbsolutePath);
    }

    private static string NormalizePath(string path)
    {
        if (string.IsNullOrWhiteSpace(path) || path == "/")
        {
            return "/";
        }

        return "/" + path.Trim('/');
    }

    private static IEnumerable<CoronaNavItem> FlattenItems(IEnumerable<CoronaNavItem> items)
    {
        foreach (var item in items)
        {
            yield return item;

            foreach (var child in FlattenItems(item.Children))
            {
                yield return child;
            }
        }
    }
}

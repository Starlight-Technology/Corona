@namespace Corona.Components
@implements IDisposable

@code {
    [CascadingParameter] public CoronaTabs? Parent { get; set; }

    [Parameter, EditorRequired] public string Header { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? PanelClass { get; set; }

    protected override void OnInitialized()
    {
        Parent?.Register(this);
    }

    protected override void OnParametersSet()
    {
        Parent?.NotifyItemChanged();
    }

    public void Dispose()
    {
        Parent?.Unregister(this);
    }
}

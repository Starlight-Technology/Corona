@using Corona.Components.Navigation
@using Corona.Theming
@inherits LayoutComponentBase
@implements IDisposable
@inject CoronaThemeProvider ThemeProvider

<CoronaPageHeader Title="Corona UI Documentation"
                  ShowMenuButton="@ShowMenuButton"
                  OnMenuClick="ToggleDrawer"
                  Actions="@HeaderActions" />

<div class="docs-shell">
    <CoronaDrawer Open="_drawerOpen"
                  OpenChanged="OnDrawerChanged"
                  Overlay="@DrawerOverlay"
                  Width="@($"{DrawerWidthPx}px")"
                  Class="@DrawerClass">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p class="docs-drawer-title">@DrawerTitle</p>
            <CoronaNavMenu Items="NavItems" />
        </CoronaStack>
    </CoronaDrawer>

    <main class="docs-content">
        @ChildContent
    </main>
</div>

@code {

    [Parameter]
    public RenderFragment ChildContent { get; set; }

        [Parameter] public IReadOnlyList<CoronaNavItem> NavItems { get; set; }
    [Parameter]
    public string DrawerTitle { get; set; }

    [Parameter]
    public int DrawerWidthPx { get; set; } = 300;

    [Parameter]
    public bool DrawerOverlay { get; set; }

    /// <summary>
    /// I recommend to use CoronaStack with buttons or text, but can be any rander fragment.
    /// </summary>
    [Parameter]
    public RenderFragment HeaderActions { get; set; }

    [Parameter]
    public bool ShowMenuButton { get; set; }

    [Parameter]
    public bool _drawerOpen { get; set; } = true;

    private string DrawerClass => "docs-drawer";



    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private Task OnDrawerChanged(bool open)
    {
        _drawerOpen = open;
        return Task.CompletedTask;
    }

    private Task ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        return Task.CompletedTask;
    }

    private Task ToggleTheme()
    {
        ThemeProvider.ToggleTheme();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeProvider.OnChange -= HandleThemeChanged;
    }
}

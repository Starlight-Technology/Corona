@using Corona.Components.Models
@using Corona.Components.Navigation
@using Corona.Theming
@inherits LayoutComponentBase
@inject CoronaThemeProvider ThemeProvider
@inject NavigationManager Nav



<div class="docs-shell @(DrawerOpen ? "drawer-open" : string.Empty)">
    <CoronaDrawer Open="DrawerOpen"
                  OpenChanged="OnDrawerChanged"
                  Overlay="@DrawerOverlay"
                  Width="@($"{DrawerWidthPx}px")"
                  Class="@DrawerClass">
        <CoronaStack Spacing="1rem" FullWidth="true">
            <p class="docs-drawer-title">@DrawerTitle</p>

            <CoronaNavMenu Items="ResolvedDrawerItems" />
        </CoronaStack>
    </CoronaDrawer>
    @if (Swipe)
    {
        <CoronaSwipeNavigator Items="DrawerItens">
            <main class="docs-content" style="overflow:auto" @key="Nav.Uri">
                @ChildContent
            </main>
        </CoronaSwipeNavigator>
    }
    else
    {
        <main class="docs-content" style="overflow:auto" @key="Nav.Uri">
            @ChildContent
        </main>
    }
</div>

@code {

    [Parameter]
    public bool Swipe { get; set; } = false;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public IReadOnlyList<CoronaNavItem> DrawerItens { get; set; }

    [Parameter]
    public IReadOnlyList<CoronaNavItem>? NavItems { get; set; }

    [Parameter]
    public string DrawerTitle { get; set; } = string.Empty;

    [Parameter]
    public string HeaderTitle { get; set; } = string.Empty;

    [Parameter]
    public int DrawerWidthPx { get; set; } = 300;

    [Parameter]
    public bool DrawerOverlay { get; set; }

    [Parameter]
    public IReadOnlyList<CoronaNavItem>? HeaderNavItems { get; set; }

    [Parameter]
    public bool ShowMenuButton { get; set; }

    [Parameter] public string? MenuIcon { get; set; } = "\u2630";

    [Parameter]
    public bool DrawerOpen { get; set; } = true;

    [Parameter] public EventCallback<bool> DrawerOpenChanged { get; set; }

    private string DrawerClass => "docs-drawer";

    private IReadOnlyList<CoronaNavItem> ResolvedDrawerItems => DrawerItens ?? NavItems ?? [];

    private IReadOnlyList<CoronaNavItem> ResolvedHeaderItems => HeaderNavItems ?? ResolvedDrawerItems;

    private Task OnDrawerChanged(bool open)
    {
        DrawerOpen = open;
        return DrawerOpenChanged.InvokeAsync(open);
    }

    private Task ToggleDrawer()
    {
        DrawerOpen = !DrawerOpen;
        return Task.CompletedTask;
    }
}

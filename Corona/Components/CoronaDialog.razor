@namespace Corona.Components
@implements IDisposable
@using Corona.Theming
@using Microsoft.AspNetCore.Components.Web
@inject CoronaThemeProvider ThemeProvider

@if (Open)
{
    <div class="corona-dialog-shell" @onkeydown="HandleShellKeyDown">
        @if (Overlay)
        {
            <button type="button"
                    class="corona-dialog__overlay"
                    style="@BuildOverlayStyle()"
                    aria-label="Close dialog"
                    @onclick="OnBackdropClickAsync"></button>
        }

        <section class="corona-dialog @Class"
                 style="@BuildStyle()"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 tabindex="0">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <header class="corona-dialog__header">
                    <h2 id="@TitleId" class="corona-dialog__title">@Title</h2>
                    <button type="button" class="corona-dialog__close" @onclick="CloseAsync" aria-label="Close dialog">✕</button>
                </header>
            }

            <div class="corona-dialog__content">
                @ChildContent
            </div>

            @if (Actions is not null)
            {
                <footer class="corona-dialog__actions">
                    @Actions
                </footer>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter] public CoronaTheme? Theme { get; set; }

    [Parameter] public CoronaThemeOverrides? ThemeOverrides { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool Overlay { get; set; } = true;
    [Parameter] public string? OverlayColor { get; set; }

    [Parameter] public string? Width { get; set; }
    [Parameter] public string? MaxWidth { get; set; }
    [Parameter] public string? BorderRadius { get; set; }
    [Parameter] public string? Elevation { get; set; }
    [Parameter] public string? BackgroundColor { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string TitleId { get; } = $"corona-dialog-title-{Guid.NewGuid():N}";

    private CoronaTheme ActiveTheme => (Theme ?? ThemeProvider.CurrentTheme).WithOverrides(ThemeOverrides);


    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string BuildStyle()
    {
        var semantic = ActiveTheme.Semantic;

        return $"width:{Width ?? "100%"};max-width:{MaxWidth ?? "40rem"};border-radius:{BorderRadius ?? semantic.RadiusCard};box-shadow:{Elevation ?? semantic.ElevationCard};background-color:{BackgroundColor ?? semantic.CardBackground};color:{semantic.TextPrimary};font-family:{semantic.FontFamilyDefault};";
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private string BuildOverlayStyle()
    {
        var semantic = ActiveTheme.Semantic;
        var overlay = OverlayColor ?? $"color-mix(in srgb, {semantic.TextPrimary} 45%, transparent)";
        return $"background:{overlay};";
    }

    private Task OnBackdropClickAsync()
    {
        if (!CloseOnBackdrop)
        {
            return Task.CompletedTask;
        }

        return CloseAsync();
    }

    private Task HandleShellKeyDown(KeyboardEventArgs args)
    {
        if (CloseOnEscape && args.Key == "Escape")
        {
            return CloseAsync();
        }

        return Task.CompletedTask;
    }
    public void Dispose()
    {
        ThemeProvider.OnChange -= HandleThemeChanged;
    }

}

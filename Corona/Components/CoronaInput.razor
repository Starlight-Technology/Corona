@namespace Corona.Components
@using Corona.Theming
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Xml.Linq
@inject CoronaThemeProvider ThemeProvider

@inherits InputBase<string>

<div class="corona-input @Class" style="@BuildStyle()">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="corona-input__label">@Label</label>
    }
    @if (Disabled)
    {
        <input @attributes="AdditionalAttributes"
               class="corona-input__field"
               type="@Type"
               value="@_displayValue"
               @oninput="OnInput"
               disabled
               placeholder="@Placeholder" />
    }
    else
    {
        <input @attributes="AdditionalAttributes"
               class="corona-input__field"
               type="@Type"
               value="@_displayValue"
               @oninput="OnInput"
               placeholder="@Placeholder" />
    }

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <span class="corona-input__helper">@HelperText</span>
    }
</div>

@code {
    [CascadingParameter] public CoronaTheme? Theme { get; set; }

    [Parameter] public CoronaThemeOverrides? ThemeOverrides { get; set; }

    // Core API (InputBase already fornece Value e ValueExpression internamente)
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Type { get; set; } = "text";

    // UX
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Disabled { get; set; }

    // Style
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }

    private string _displayValue = string.Empty;

    private CoronaTheme ActiveTheme => (Theme ?? ThemeProvider.CurrentTheme).WithOverrides(ThemeOverrides);

    protected override void OnParametersSet()
    {
        _displayValue = FormatValueForDisplay(CurrentValue);
    }

    private string BuildStyle()
    {
        var semantic = ActiveTheme.Semantic;
        return $"width:{Width ?? "100%"};font-family:{semantic.FontFamilyDefault};";
    }

    private async Task OnValueChange(ChangeEventArgs e)
    {
        if (Disabled)
            return;

        await OnInput(e);
    }

    // Evento oninput do input HTML
    private async Task OnInput(ChangeEventArgs e)
    {
        if (Disabled)
            return;

        var raw = e.Value?.ToString() ?? string.Empty;

        var digits = Type switch
        {
            "currency" => UnmaskCurrency(raw),
            "phone" => UnmaskPhone(raw),
            _ => raw
        };

        var formatted = FormatValueForDisplay(digits);

        // Valor interno deve ser SEM formatação
        CurrentValue = digits;

        // Valor exibido deve ser formatado
        _displayValue = formatted;
    }


    // InputBase<string> exige implementação de TryParseValueFromString
    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        // Para string não precisamos converter; apenas repassa o valor
        result = value ?? "";
        validationErrorMessage = String.Empty;
        return true;
    }

    // ---------- Formatação / Desmascaramento ----------
    private string FormatCurrency(string? digits)
    {
        if (string.IsNullOrWhiteSpace(digits))
            return "";

        if (!long.TryParse(digits, out var number))
            return "";

        var val = number / 100m;

        return val.ToString("C", new CultureInfo("pt-BR"));
    }


    private string UnmaskCurrency(string raw)
    {
        return new string(raw.Where(char.IsDigit).ToArray());
    }



    private string FormatPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var digits = new string(value.Where(char.IsDigit).ToArray());

        if (digits.Length > 11)
            digits = digits[..11];

        return digits.Length switch
        {
            <= 2 => $"({digits}",
            <= 6 => $"({digits[..2]}) {digits[2..]}",
            <= 9 => $"({digits[..2]}) {digits[2..6]} {digits[6..]}",
            _ => $"({digits[..2]}) {digits[2..7]} {digits[7..]}",
        };
    }

    private string UnmaskPhone(string raw)
    {
        return new string(raw.Where(char.IsDigit).ToArray());
    }

    private string FormatValueForDisplay(string? value)
    {
        return Type switch
        {
            "currency" => FormatCurrency(value),
            "phone" => FormatPhone(value),
            _ => value ?? string.Empty
        };
    }
}

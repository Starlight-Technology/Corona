@namespace Corona.Components
@implements IDisposable
@using Corona.Components.Enums
@using Corona.Theming
@inject CoronaThemeProvider ThemeProvider

<div class="corona-card @(Hoverable ? "is-hoverable" : string.Empty) @Class"
     style="@BuildStyle()">

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="corona-card-header" style="@BuildHeaderStyle()">
            @Title
        </div>
    }

    <div class="corona-card-content" style="@BuildContentStyle()">
        @ChildContent
    </div>
</div>

@code {
    [CascadingParameter] public CoronaTheme? Theme { get; set; }

    /// <summary>
    /// Optional component-level theme overrides.
    /// </summary>
    [Parameter] public CoronaThemeOverrides? ThemeOverrides { get; set; }

    // ===== CONTENT =====
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // ===== SIZE =====
    [Parameter] public string Width { get; set; } = "auto";
    [Parameter] public string Height { get; set; } = "auto";
    [Parameter] public string Margin { get; set; } = "0";

    // ===== STYLE =====
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? BackgroundColor { get; set; }
    [Parameter] public bool Hoverable { get; set; } = true;


    // ===== HEADER =====
    [Parameter] public CoronaTextAlign HeaderTextAlign { get; set; } = CoronaTextAlign.Left;

    // ===== CONTENT =====
    [Parameter] public CoronaTextAlign ContentTextAlign { get; set; } = CoronaTextAlign.Left;
    [Parameter] public CoronaFlexAlign ContentJustify { get; set; } = CoronaFlexAlign.Start;
    [Parameter] public CoronaItemsAlign ContentAlignItems { get; set; } = CoronaItemsAlign.Stretch;

    private CoronaTheme ActiveTheme => (Theme ?? ThemeProvider.CurrentTheme).WithOverrides(ThemeOverrides);


    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string BuildStyle()
    {
        var semantic = ActiveTheme.Semantic;

        return $@"
            width:{Width};
            height:{Height};
            margin:{Margin};
            padding:0;
            background: {BackgroundColor ?? semantic.CardBackground};
            color:{semantic.TextPrimary};
            border-radius:{semantic.RadiusCard};
            box-shadow:{semantic.ElevationCard};
            border:1px solid {semantic.BorderDefault};
            display:flex;
            flex-direction:column;
            overflow:hidden;
            font-family:{semantic.FontFamilyDefault};
        ";
    }

    private string BuildHeaderStyle()
    {
        var semantic = ActiveTheme.Semantic;

        return $@"
            padding:{semantic.SpacingCardHeader} {semantic.SpacingCard} 0 {semantic.SpacingCard};
            color:{semantic.TextPrimary};
            font-size:{semantic.FontSizeHeading};
            font-weight:{semantic.FontWeightHeading};
            text-align:{MapTextAlign(HeaderTextAlign)};
        ";
    }

    private string BuildContentStyle()
    {
        var semantic = ActiveTheme.Semantic;

        return $@"
            padding:{semantic.SpacingCard};
            font-size:{semantic.FontSizeBody};
            color:{semantic.TextSecondary};
            flex:1;
            text-align:{MapTextAlign(ContentTextAlign)};
            display:flex;
            justify-content:{MapFlexAlign(ContentJustify)};
            align-items:{MapItemsAlign(ContentAlignItems)};
            flex-direction:column;
        ";
    }

    private static string MapTextAlign(CoronaTextAlign align) => align switch
    {
        CoronaTextAlign.Left => "left",
        CoronaTextAlign.Center => "center",
        CoronaTextAlign.Right => "right",
        CoronaTextAlign.Justify => "justify",
        _ => "left"
    };

    private static string MapFlexAlign(CoronaFlexAlign align) => align switch
    {
        CoronaFlexAlign.Start => "flex-start",
        CoronaFlexAlign.Center => "center",
        CoronaFlexAlign.End => "flex-end",
        CoronaFlexAlign.SpaceBetween => "space-between",
        CoronaFlexAlign.SpaceAround => "space-around",
        CoronaFlexAlign.SpaceEvenly => "space-evenly",
        _ => "flex-start"
    };

    private static string MapItemsAlign(CoronaItemsAlign align) => align switch
    {
        CoronaItemsAlign.Start => "flex-start",
        CoronaItemsAlign.Center => "center",
        CoronaItemsAlign.End => "flex-end",
        CoronaItemsAlign.Stretch => "stretch",
        _ => "stretch"
    };
    public void Dispose()
    {
        ThemeProvider.OnChange -= HandleThemeChanged;
    }

}

<style>
    .corona-card {
        transition: all .2s ease;
    }

    .corona-card.is-hoverable:hover {
        transform: translateY(-2px);
    }
</style>
